# Copy to .env.local (or .env). Never commit it.
# LiveKit Cloud -> your project -> Settings -> API keys. Or run: lk app env -w
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Phone practice: where the website is, and the secret it shares with this agent (same value as on Render)
SUNNY_SITE_URL=https://pm-job-hunter-qfva.onrender.com
SUNNY_AGENT_SECRET=

# ---- Settings to experiment with: change ONE, restart, talk, write it down in EXPERIMENTS.md ----
# Voice (Cartesia voice id from https://play.cartesia.ai/voices; empty = default voice)
TTS_VOICE=
TTS_MODEL=cartesia/sonic-3

# Turn detection: model | vad | stt
TURN_DETECTION=model
MIN_ENDPOINTING_DELAY=0.5
MAX_ENDPOINTING_DELAY=3.0

# Interruption
ALLOW_INTERRUPTIONS=true
MIN_INTERRUPTION_DURATION=0.5
MIN_INTERRUPTION_WORDS=0

# Background noise and latency
NOISE_CANCELLATION=true
PREEMPTIVE_GENERATION=true

# Models
STT_MODEL=deepgram/nova-3
STT_LANGUAGE=multi
LLM_MODEL=openai/gpt-4.1-mini
