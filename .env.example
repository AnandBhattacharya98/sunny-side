# Job Hunter Board configuration

# ── Required in production ──────────────────────────────────────────────────
# Long random string. Signs logins and (unless DATA_ENCRYPTION_KEY is set) encrypts saved credentials.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Password for the built-in admin account (username: admin). Applied on every startup.
ADMIN_PASSWORD=
# Shared token your scheduler sends as the X-Cron-Token header to /api/cron/daily-recommendations
CRON_SECRET=

# Optional: separate Fernet key for encrypting users' saved Gmail app passwords and Gemini keys
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
# Optional: PostgreSQL connection string (defaults to local SQLite jobs.db)
DATABASE_URL=

# ── API Keys ────────────────────────────────────────────────────────────────
# Add your Anthropic API key to enable Claude-based scoring & cover letters (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server-wide Gemini key for scoring, STT, TTS, and coaching (Optional).
# Users can also add their own key in settings; a personal key is never shared with other users.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional overrides for the Board Assistant's Gemini models
# GEMINI_VOICE_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Puck

# ── Email Settings (For daily alerts / sending cover letters) ───────────────
# Each user's digest goes to their own sign-in email or connected Gmail.
SENDER_EMAIL=your_alerts_sender_gmail@gmail.com
SENDER_PASSWORD=your_gmail_app_password_here

# ── Email Scraper Settings (admin account only) ─────────────────────────────
# This inbox is only synced for the admin account. Other users connect their own Gmail in settings.
IMAP_SERVER=imap.gmail.com
IMAP_EMAIL=your_email_to_sync@gmail.com
IMAP_PASSWORD=your_imap_password_or_gmail_app_password

# ── Fallback candidate info (only used before a user uploads a resume) ──────
YOUR_NAME=
YEARS_EXPERIENCE=2
LOCATION=

# ── Google / LinkedIn OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Local development only ──────────────────────────────────────────────────
# Enables the fake "Dev Mode" Google/LinkedIn sign-in. Never set this on a public server.
ALLOW_DEV_LOGIN=0
# Set to 0 when running over plain http (not localhost) so the login cookie is sent
SESSION_COOKIE_SECURE=1
