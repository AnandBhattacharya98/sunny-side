# PM Job Hunter Configuration

# ── API Keys ────────────────────────────────────────────────────────────────
# Add your Anthropic API key to enable Claude-based scoring & cover letters (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Add your Gemini API key to enable Gemini-based scoring, STT, TTS, and coaching (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Email Settings (For daily alerts / sending cover letters) ───────────────
SENDER_EMAIL=your_alerts_sender_gmail@gmail.com
SENDER_PASSWORD=your_gmail_app_password_here

# ── Email Scraper Settings (For auto-syncing job application statuses) ──────
# Default server is imap.gmail.com (Gmail). Change if using another provider.
IMAP_SERVER=imap.gmail.com
IMAP_EMAIL=your_email_to_sync@gmail.com
IMAP_PASSWORD=your_imap_password_or_gmail_app_password

# ── Candidate Info Overrides (Optional — defaults are set in ai_engine.py) ────
YOUR_NAME=Your Full Name
YEARS_EXPERIENCE=1
LOCATION=Bengaluru

# ── Google OAuth Configurations ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
